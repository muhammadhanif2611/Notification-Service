# ==============================================================================
# 🔧 NOTIFICATION GATEWAY — ENVIRONMENT VARIABLES MASTER TEMPLATE
# ==============================================================================
# 💡 PANDUAN PEMISAHAN ENVIRONMENT:
#
# 1. 💻 PENGEMBANGAN LOKAL:
#    Gunakan file `.env.local` (diprioritaskan di atas file ini).
#    Salin template khusus lokal:
#      cp .env.local.example .env.local         (Linux/Mac)
#      Copy-Item .env.local.example .env.local  (Windows PowerShell)
#
# 2. 🚂 PRODUKSI RAILWAY:
#    Lihat file `.env.railway.example` dan `RAILWAY_DEPLOYMENT_GUIDE.md`
#    untuk konfigurasi Railway Variables, Private Networking, PostgreSQL, & PostgREST.
#
# 3. 🐳 DOCKER COMPOSE LOKAL:
#    Salin file ini menjadi `.env` lalu jalankan `docker compose up -d --build`.
# ==============================================================================

# ──────────────────────────────────────────────
# 🗄️ DATABASE (SUPABASE / RAILWAY POSTGREST)
# ──────────────────────────────────────────────
# Opsi 1: Supabase Cloud (Default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsi 2: PostgREST di Railway / Standalone
# Aktifkan flag ini jika menggunakan PostgREST langsung tanpa prefix /rest/v1
# POSTGREST_DIRECT=true

# ──────────────────────────────────────────────
# 📨 REDIS (MESSAGE QUEUE & BULLMQ)
# ──────────────────────────────────────────────
# [Opsi A] Redis URL (Upstash / Railway Redis / Lokal)
REDIS_URL=redis://127.0.0.1:6379

# [Opsi B] Redis Host & Port
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ──────────────────────────────────────────────
# 🔐 KEAMANAN (JWT & AES ENCRYPTION)
# ──────────────────────────────────────────────
# JWT Secret untuk otentikasi user & dashboard
JWT_SECRET=ganti-dengan-secret-key-yang-kuat-min-32-karakter

# 32-byte hex string untuk enkripsi AES-256-GCM kredensial vendor
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# 🌐 SERVICE URLS (GATEWAY ROUTING)
# ──────────────────────────────────────────────
# Untuk lokal: gunakan localhost/127.0.0.1
# Untuk Railway: gunakan Railway Private Domain (lihat .env.railway.example)
AUTH_SERVICE_URL=http://localhost:3002
CLIENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
CALLBACK_LOG_SERVICE_URL=http://localhost:3005
DISPATCH_SERVICE_URL=http://localhost:3006

# ──────────────────────────────────────────────
# 🖥️ FRONTEND & CORS
# ──────────────────────────────────────────────
# URL gateway yang dihubungi browser klien
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Domain frontend yang diizinkan oleh CORS gateway (pisahkan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────
# ⚙️ NODE ENVIRONMENT
# ──────────────────────────────────────────────
NODE_ENV=development