# ==============================================================================
# 💻 NOTIFICATION GATEWAY — LOCAL ENVIRONMENT (.env.local)
# ==============================================================================
# File ini digunakan khusus untuk pengembangan di mesin LOKAL.
# Cara pakai:
#   cp .env.local.example .env.local         (Linux/Mac)
#   Copy-Item .env.local.example .env.local  (Windows PowerShell)
#
# File .env.local diprioritaskan di atas .env dan TIDAK AKAN di-commit ke Git.
# ==============================================================================

# ──────────────────────────────────────────────
# 🗄️ DATABASE (SUPABASE / LOCAL POSTGREST)
# ──────────────────────────────────────────────
# Opsi 1: Supabase Cloud (Default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsi 2: PostgREST Lokal (jika memakai PostgreSQL lokal)
# SUPABASE_URL=http://127.0.0.1:3000
# SUPABASE_SERVICE_ROLE_KEY=local-secret
# POSTGREST_DIRECT=true

# ──────────────────────────────────────────────
# 📨 REDIS (MESSAGE QUEUE & BULLMQ)
# ──────────────────────────────────────────────
# Opsi A: Redis Lokal (Docker / Memurai / WSL)
REDIS_URL=redis://127.0.0.1:6379

# Opsi B: Upstash Redis (Cloud)
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ──────────────────────────────────────────────
# 🔐 KEAMANAN & ENKRIPSI
# ──────────────────────────────────────────────
# JWT Secret untuk sesi login dashboard (minimal 32 karakter)
JWT_SECRET=rahasia-jwt-lokal-pengembangan-notification-gateway-2026

# AES-256-GCM Key (32-byte hex string) untuk mengenkripsi kredensial vendor
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=d7a31f8b65287c12f2048f0e52719a710bc4928d1c9ef007b8b209a3cf8419de

# ──────────────────────────────────────────────
# 🌐 SERVICE URLS (GATEWAY PROXY ROUTING LOKAL)
# ──────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3002
CLIENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
CALLBACK_LOG_SERVICE_URL=http://localhost:3005
DISPATCH_SERVICE_URL=http://localhost:3006

# ──────────────────────────────────────────────
# 🖥️ FRONTEND (NEXT.JS)
# ──────────────────────────────────────────────
# PENTING: gunakan 127.0.0.1 di Windows untuk menghindari IPv6 localhost latency
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# CORS allowed origins untuk gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────
# ⚙️ NODE ENVIRONMENT
# ──────────────────────────────────────────────
NODE_ENV=development
