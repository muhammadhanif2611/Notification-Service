{
    "name": "notification-gateway/sdk",
    "description": "Official PHP SDK for Notification Gateway — kirim WhatsApp, Email, dan Broadcast notifikasi.",
    "type": "library",
    "keywords": ["notification", "whatsapp", "email", "broadcast", "gateway", "sdk"],
    "homepage": "https://github.com/your-org/notification-service",
    "license": "MIT",
    "authors": [
        {
            "name": "Notification Gateway",
            "email": "dev@notification-gateway.id"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationGateway\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
