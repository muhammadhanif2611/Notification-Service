# ==============================================================================
# 🚂 NOTIFICATION GATEWAY — RAILWAY PRODUCTION ENVIRONMENT (.env.railway.example)
# ==============================================================================
# Panduan variabel environment untuk deployment di Railway (Multi-Service).
# Di Railway, variabel ini dimasukkan ke dashboard Railway per-service atau via
# menu "Shared Variables" di Project Settings.
# ==============================================================================

# ==============================================================================
# 1. SHARED VARIABLES (PROJECT SETTINGS -> SHARED VARIABLES)
# ==============================================================================
# Variabel ini dibagikan ke seluruh service backend otomatis:

NODE_ENV=production

# 🔐 Kunci JWT (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-secret-key-produksi-yang-sangat-kuat-min-32-char

# 🔑 Kunci AES-256 (32-byte hex string) untuk enkripsi kredensial vendor
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=ganti-dengan-32-byte-hex-string-hasil-generate-crypto

# 🗄️ Koneksi Database PostgREST di Railway
# Menggunakan Railway Private Networking agar aman dan berkecepatan tinggi:
POSTGREST_DIRECT=true
SUPABASE_URL=http://${{postgrest.RAILWAY_PRIVATE_DOMAIN}}:3000
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-secret-key-produksi-yang-sangat-kuat-min-32-char

# 📨 Koneksi Redis di Railway
# Otomatis diambil dari service Redis bawaan Railway:
REDIS_URL=${{Redis.REDIS_URL}}


# ==============================================================================
# 2. KONFIGURASI PER-SERVICE DI RAILWAY DASHBOARD
# ==============================================================================

# ------------------------------------------------------------------------------
# 📦 SERVICE: Postgres (Railway Official PostgreSQL)
# ------------------------------------------------------------------------------
# - Cukup tambahkan plugin "PostgreSQL" dari menu New -> Database.
# - Railway otomatis men-generate: DATABASE_URL, PGHOST, PGPORT, dll.
# - Jalankan skrip scripts/railway-init.sql melalui tab "Data" -> "Query".

# ------------------------------------------------------------------------------
# 📦 SERVICE: postgrest (Docker Image: postgrest/postgrest:latest)
# ------------------------------------------------------------------------------
# New -> Docker Image -> postgrest/postgrest:latest
# Environment Variables pada service postgrest:
PGRST_DB_URI=${{Postgres.DATABASE_URL}}
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=ganti-dengan-secret-key-produksi-yang-sangat-kuat-min-32-char
PORT=3000

# ------------------------------------------------------------------------------
# 📦 SERVICE: gateway-service (Port 3001 - Public Domain)
# ------------------------------------------------------------------------------
# Dockerfile: services/gateway-service/Dockerfile
# Root Directory: /
# Generate Public Domain di Networking (misal: gateway-production.up.railway.app)
PORT=3001
AUTH_SERVICE_URL=http://${{auth-service.RAILWAY_PRIVATE_DOMAIN}}:3002
CLIENT_SERVICE_URL=http://${{client-service.RAILWAY_PRIVATE_DOMAIN}}:3003
NOTIFICATION_SERVICE_URL=http://${{notification-service.RAILWAY_PRIVATE_DOMAIN}}:3004
CALLBACK_LOG_SERVICE_URL=http://${{callback-log-service.RAILWAY_PRIVATE_DOMAIN}}:3005
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# ------------------------------------------------------------------------------
# 📦 SERVICE: frontend (Next.js Dashboard - Port 3000 - Public Domain)
# ------------------------------------------------------------------------------
# Dockerfile: frontend/Dockerfile
# Root Directory: /
# Generate Public Domain di Networking (misal: dashboard-production.up.railway.app)
PORT=3000
NEXT_PUBLIC_API_URL=https://${{gateway-service.RAILWAY_PUBLIC_DOMAIN}}

# ------------------------------------------------------------------------------
# 📦 SERVICE: auth-service (Port 3002 - Private Only)
# ------------------------------------------------------------------------------
# Dockerfile: services/auth-service/Dockerfile
# Root Directory: /
PORT=3002

# ------------------------------------------------------------------------------
# 📦 SERVICE: client-service (Port 3003 - Private Only)
# ------------------------------------------------------------------------------
# Dockerfile: services/client-service/Dockerfile
# Root Directory: /
PORT=3003

# ------------------------------------------------------------------------------
# 📦 SERVICE: notification-service (Port 3004 - Private Only)
# ------------------------------------------------------------------------------
# Dockerfile: services/notification-service/Dockerfile
# Root Directory: /
PORT=3004

# ------------------------------------------------------------------------------
# 📦 SERVICE: dispatch-service (Worker Background - Private Only)
# ------------------------------------------------------------------------------
# Dockerfile: services/dispatch-service/Dockerfile
# Root Directory: /
# Tambahkan Railway Volume (Mount path: /app/wa-sessions) untuk sesi WhatsApp persisten
WA_SESSION_PATH=/app/wa-sessions

# ------------------------------------------------------------------------------
# 📦 SERVICE: callback-log-service (Port 3005 - Private Only)
# ------------------------------------------------------------------------------
# Dockerfile: services/callback-log-service/Dockerfile
# Root Directory: /
PORT=3005
